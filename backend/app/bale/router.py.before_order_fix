        return True

    choice = int(text.strip())
    order_ids = session["order_ids"]

    if choice < 1 or choice > len(order_ids):
        await send_message(
            chat_id,
            "شماره سفارش نامعتبر است.",
        )
        return True

    db = SessionLocal()

    try:
