async def handle_order_date_choice(chat_id: str, text: str):
    session = SESSIONS.get(str(chat_id))

    if not session or session.get("state") != "order_choose_date":
        return False

    choice = text.strip()

    if choice not in {"1", "2"}:
        await send_message(
            chat_id,
            "لطفاً فقط 1 یا 2 را ارسال کنید.\n\n"
            "1️⃣ امروز\n"
            "2️⃣ فردا",
        )
        return True

    # تاریخ امروز فقط یک بار محاسبه می‌شود
    today = today_iran()

    if choice == "1":
        target_date = today
        day_title = "امروز"
    else:
        target_date = today + timedelta(days=1)
        day_title = "فردا"

    db = SessionLocal()

    try:
        employee = (
            db.query(Employee)
            .filter(Employee.id == session["employee_id"])
            .first()
        )

        if not employee:
            await send_message(
                chat_id,
                "کاربر پیدا نشد.\n"
                "لطفاً دوباره /start را ارسال کنید.",
            )
            clear_session(chat_id)
            return True

        # -------------------------------------------------
        # سفارش قبلی
        # -------------------------------------------------

        existing = (
            db.query(PersonalOrder)
            .filter(
                PersonalOrder.employee_id == employee.id,
                PersonalOrder.date == target_date,
            )
            .first()
        )

        if existing:

            if can_increase_order(db, target_date):

                SESSIONS[str(chat_id)] = {
                    "state": "increase_quantity",
                    "employee_id": employee.id,
                    "order_id": existing.id,
                    "target_date": target_date,
                }

                await send_message(
                    chat_id,
                    f"برای {target_date.strftime('%Y/%m/%d')} "
                    "قبلاً سفارش دارید.\n\n"
                    f"🍽 غذا: {existing.food.name}\n"
                    f"🔢 تعداد فعلی: {existing.quantity}\n\n"
                    "برای افزایش تعداد، تعداد جدید را ارسال کنید.\n"
                    "مثال: 3",
                )

            else:

                await send_message(
                    chat_id,
                    f"برای {target_date.strftime('%Y/%m/%d')} "
                    "قبلاً سفارش ثبت شده است.\n\n"
                    f"🍽 غذا: {existing.food.name}\n"
                    f"🔢 تعداد: {existing.quantity}\n"
                    f"🎫 کد پیگیری: {existing.tracking_code}\n\n"
                    "در صورت نیاز می‌توانید /order را ارسال کنید.",
                )

                clear_session(chat_id)

            return True

        # -------------------------------------------------
        # بررسی مهلت ثبت سفارش جدید
        # -------------------------------------------------

        if not can_create_order_for_date(db, target_date):

            if target_date == today:

                deadline = get_setting_value(
                    db,
                    "SAME_DAY_DEADLINE",
                    "09:00",
                )

                message = (
                    f"⛔ مهلت ثبت سفارش {day_title} "
                    f"تا ساعت {deadline} بوده و به پایان رسیده است."
                )

            else:

                deadline = get_setting_value(
                    db,
                    "NORMAL_DEADLINE",
                    "15:00",
                )

                message = (
                    f"⛔ مهلت ثبت سفارش {day_title} "
                    f"تا ساعت {deadline} امروز بوده و به پایان رسیده است."
                )

            # مهم:
            # Session پاک نمی‌شود.
            # کاربر می‌تواند بلافاصله گزینه دیگر را انتخاب کند.
            SESSIONS[str(chat_id)] = {
                "state": "order_choose_date",
                "employee_id": employee.id,
                "site_id": employee.site_id,
            }

            await send_message(
                chat_id,
                message
                + "\n\n"
                "می‌توانید روز دیگری را انتخاب کنید:\n\n"
                "1️⃣ امروز\n"
                "2️⃣ فردا",
            )

            return True

        # -------------------------------------------------
        # دریافت منوی همان تاریخ
        # -------------------------------------------------

        menu_entries = get_menu(
            db,
            employee.site_id,
            target_date,
        )

        if not menu_entries:

            # Session حفظ می‌شود تا کاربر بتواند روز دیگر را امتحان کند.
            SESSIONS[str(chat_id)] = {
                "state": "order_choose_date",
                "employee_id": employee.id,
                "site_id": employee.site_id,
            }

            await send_message(
                chat_id,
                f"برای تاریخ {target_date.strftime('%Y/%m/%d')} "
                "منوی منتشرشده‌ای وجود ندارد.\n\n"
                "روز دیگری را انتخاب کنید:\n\n"
                "1️⃣ امروز\n"
                "2️⃣ فردا",
            )

            return True

