async def handle_cancel_choice(chat_id: str, text: str):
    session = SESSIONS.get(str(chat_id))

    if not session or session.get("state") != "cancel_choose":
        return False

    if not text.strip().isdigit():
        await send_message(
            chat_id,
            "لطفاً شماره سفارش را ارسال کنید.",
